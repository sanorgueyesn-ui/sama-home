// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Multi-tenant — Établissements (Phase 1 : schéma additif uniquement)
// ---------------------------------------------------------------------------

enum EstablishmentStatus {
  /// Inscription créée, en attente d'approbation explicite par un
  /// administrateur de plateforme — aucun accès aux fonctionnalités métier.
  PENDING
  /// Approuvé — accès complet, strictement limité à ses propres données.
  ACTIVE
  /// Refusé explicitement — ne redevient jamais PENDING automatiquement.
  REJECTED
  /// Était ACTIVE, suspendu manuellement par un administrateur de
  /// plateforme — distinct d'une expiration d'abonnement (voir Subscription
  /// ci-dessous, axe totalement indépendant de ce statut).
  SUSPENDED
}

/// Un établissement (tenant). Toutes les données métier existantes
/// (Client, Property, Reservation, Rental, Payment, Expense*, CashRegister,
/// CashSession, CashCorrection, BankAccount, BankTransfer, TransferSchedule)
/// seront rattachées à un établissement via `establishmentId` — nullable
/// dans cette Phase 1 (migration strictement additive), rendu obligatoire
/// seulement après le backfill complet des données existantes (Phase
/// ultérieure, non couverte ici). `Session` n'a volontairement AUCUNE
/// colonne de rattachement propre : elle hérite du tenant via
/// `Session.userId -> User.establishmentId`.
///
/// Suppression : jamais une suppression SQL physique depuis l'application
/// (décision produit validée — désactivation définitive avec conservation
/// physique des données). `onDelete: Restrict` partout, cohérent avec la
/// convention déjà en place sur chaque relation de ce schéma.
model Establishment {
  id        String              @id @default(cuid())
  name      String
  status    EstablishmentStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  users    User[]
  settings Settings?

  clients           Client[]
  properties        Property[]
  tariffs           Tariff[]
  reservations      Reservation[]
  rentals           Rental[]
  rentalExtensions  RentalExtension[]
  payments          Payment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  auditLogs         AuditLog[]
  cashRegisters     CashRegister[]
  cashSessions      CashSession[]
  cashCorrections   CashCorrection[]
  bankAccounts      BankAccount[]
  bankTransfers     BankTransfer[]
  transferSchedules TransferSchedule[]

  notifications Notification[]
  subscription  Subscription?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 2 — Authentification
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  GESTIONNAIRE
}

model User {
  id           String  @id @default(cuid())
  /// Identifiant de connexion (voir écran "Splash / Connexion" de la maquette)
  username     String  @unique
  passwordHash String
  name         String
  /// Lot multi-tenant — collecté uniquement pour les comptes créés via
  /// l'inscription publique d'un établissement (nécessaire pour les
  /// notifications d'approbation/refus) ; jamais exigé pour les comptes
  /// créés en interne par un ADMIN existant (`createUser`, inchangé).
  email        String?

  /// Nullable depuis le lot multi-tenant : un compte de plateforme
  /// (`isPlatformAdmin = true`) n'a pas de rôle d'établissement — ce champ
  /// n'a de sens que pour un compte rattaché à un établissement. Plus de
  /// valeur par défaut (l'ancien `@default(GESTIONNAIRE)` est retiré :
  /// un compte de plateforme créé sans préciser `role` doit rester NULL,
  /// jamais hériter silencieusement d'un rôle d'établissement trompeur).
  /// Une contrainte CHECK liant `role` et `establishmentId` (les deux
  /// renseignés ensemble, ou aucun des deux) sera ajoutée dans une phase
  /// ultérieure, après le backfill des comptes existants — jamais dans
  /// cette migration additive.
  role UserRole?

  /// Lot multi-tenant — `true` uniquement pour le compte spécial
  /// d'administration de la plateforme (distinct du compte habituel de
  /// gestion d'un établissement). Jamais accordé implicitement : voir le
  /// plan de bootstrap (hors périmètre de cette Phase 1).
  isPlatformAdmin Boolean @default(false)

  /// Permissions granulaires sous forme JSON (ex: modules plateforme ou d'établissement autorisés)
  permissions String?

  /// Nullable : NULL pour un compte de plateforme (aucun établissement),
  /// renseigné pour tout compte d'établissement. `onDelete: Restrict` —
  /// cohérent avec la convention déjà en place sur chaque relation de ce
  /// schéma (jamais de perte silencieuse de compte).
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  /// Traçabilité de l'enregistrement rétroactif d'une arrivée (Bloc 21) — qui
  /// a réellement saisi la location, distinct du client qui y séjourne.
  rentalsRegistered Rental[]   @relation("RentalRegisteredBy")

  /// Journal générique des opérations sensibles (Bloc 15).
  auditLogs         AuditLog[] @relation("AuditLogUser")

  /// Caisse & Banque (Bloc 17.2).
  cashSessionsOpened       CashSession[]      @relation("CashSessionOpenedBy")
  cashSessionsClosed       CashSession[]      @relation("CashSessionClosedBy")
  cashCorrections          CashCorrection[]
  bankAccountsCreated      BankAccount[]
  bankTransfersCreated     BankTransfer[]     @relation("BankTransferCreatedBy")
  bankTransfersEffected    BankTransfer[]     @relation("BankTransferEffectedBy")
  transferSchedulesCreated TransferSchedule[]

  /// Lot multi-tenant — plateforme et abonnements.
  notificationReads             NotificationRead[]
  subscriptionPaymentsConfirmed SubscriptionPayment[] @relation("SubscriptionPaymentConfirmedBy")

  @@index([establishmentId])
}

/// Session serveur (DB-backed) : la valeur en base fait autorité, le cookie
/// n'est qu'une référence signée vers elle (voir src/lib/session.ts).
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Clients
// ---------------------------------------------------------------------------

/// `idDocumentType` reste une chaîne libre (pas un enum) : le prompt maître
/// n'énumère pas les types de pièce acceptés, et les figer maintenant serait
/// inventer une règle métier non demandée. L'UI suggère quelques valeurs
/// courantes via des puces, sans empêcher la saisie libre.
model Client {
  id    String @id @default(cuid())
  name  String
  /// Normalisé à la création/modification (espaces/points/tirets retirés,
  /// "+" initial conservé) pour que la recherche soit fiable — voir
  /// src/lib/definitions.ts, ClientSchema.
  phone String

  email            String?
  address          String?
  idDocumentType   String?
  idDocumentNumber String?
  notes            String?

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payment appartient à une phase suivante ; elle ajoutera sa propre
  // relation vers Client sans modifier ce modèle davantage.
  reservations Reservation[]
  rentals      Rental[]

  @@index([phone])
  @@index([name])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 4 — Logements
// ---------------------------------------------------------------------------

enum PropertyType {
  ROOM
  APARTMENT
}

/// Un logement (chambre meublée ou appartement).
///
/// Volontairement PAS de colonne "status" : le prompt maître interdit un
/// statut manuel qui pourrait contredire les futures réservations/locations.
/// Le statut affiché (AVAILABLE/OCCUPIED/RESERVED/UNAVAILABLE) est calculé à
/// la volée par src/lib/property-status.ts à partir de `active`, des
/// réservations CONFIRMED proches et des locations ACTIVE (Phase 7) — sans
/// qu'aucune colonne supplémentaire n'ait été ajoutée ici.
///
/// `photo` (lot "Téléversement durable des images") : stocke désormais soit
/// une clé d'objet du Bucket Railway (S3-compatible, "logements/<uuid>.ext",
/// générée par src/lib/image-upload.ts — jamais le nom de fichier fourni par
/// l'utilisateur), soit, pour toute donnée enregistrée AVANT ce lot, un lien
/// http(s) collé directement (ancien mode V1, conservé tel quel, jamais
/// migré automatiquement). Les deux formats sont résolus en URL d'affichage
/// au point de lecture (src/lib/properties-data.ts, src/lib/reservations-data.ts)
/// via src/lib/object-storage.ts — aucune migration de colonne n'était
/// nécessaire, String? convenait déjà aux deux formats.
model Property {
  id          String       @id @default(cuid())
  name        String
  type        PropertyType
  description String?
  capacity    Int
  photo       String?
  active      Boolean      @default(true)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tariffs      Tariff[]
  reservations Reservation[]
  rentals      Rental[]

  @@index([type])
  @@index([active])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 5 — Tarifs
// ---------------------------------------------------------------------------

/// Catégorie tarifaire (vocabulaire métier, français). Base V1 imposée par le
/// prompt maître — ne pas en ajouter sans le signaler d'abord.
enum TariffType {
  HEURE
  NUIT
  JOUR
  SEMAINE
  MOIS
}

/// Unité de la durée (vocabulaire technique, anglais — délibérément distinct
/// de TariffType). Ce découplage EST la règle métier critique de la Phase 5 :
/// une durée de 24 HOURS n'est pas automatiquement un tarif JOUR, et un tarif
/// JOUR peut être exprimé en 1 DAY ou en 24 HOURS selon le choix du
/// gestionnaire. Aucune contrainte ne force un couplage type/unité.
enum DurationUnit {
  HOURS
  NIGHT
  DAY
  WEEK
  MONTH
}

/// Un tarif appartient toujours à un logement. `amount` en FCFA entier (pas
/// de sous-unité dans cette devise) : jamais de Float JS, jamais de Decimal
/// inutile pour une devise qui n'a pas de centimes.
///
/// Pas de contrainte d'unicité en base sur (propertyId, type, durationValue,
/// durationUnit) : elle casserait l'historique (un ancien tarif désactivé et
/// son remplaçant actif partagent forcément cette combinaison). La
/// prévention des doublons actifs est applicative — voir
/// src/app/actions/tariffs.ts.
///
/// Pas de suppression automatique : `active` est le mécanisme d'archivage
/// prévu pour que la Phase 6 (Réservations) puisse un jour référencer un
/// tarif historique sans qu'il ait disparu. La suppression physique reste
/// possible ici (rien ne référence encore Tariff) mais devra être bloquée
/// par la Phase 6 dès qu'une réservation peut pointer vers un tarif — voir
/// le commentaire dans deleteTariff().
model Tariff {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyId String

  label         String
  type          TariffType
  durationValue Int
  durationUnit  DurationUnit
  amount        Int
  active        Boolean      @default(true)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  rentals      Rental[]

  @@index([propertyId])
  @@index([propertyId, active])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 6 — Réservations
// ---------------------------------------------------------------------------

enum ReservationStatus {
  CONFIRMED
  /// Atteignable uniquement par une future phase Locations (arrivée réelle).
  ARRIVED
  CANCELLED
  /// Atteignable uniquement par une future phase Locations (séjour terminé).
  COMPLETED
}

/// Vocabulaire déjà donné dans le prompt maître d'origine (section 21) —
/// réutilisé ici pour `depositMethod`, pas inventé.
enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  OTHER
}

/// Une réservation. `amount`, `durationValue` et `durationUnit` sont des
/// COPIES figées au moment de la création (voir src/app/actions/reservations.ts) :
/// si le Tariff référencé est modifié plus tard, cette réservation ne doit
/// jamais être recalculée rétroactivement. `tariffId` reste la référence de
/// configuration (pour l'affichage du type/libellé), `amount` est le montant
/// réellement appliqué.
///
/// `onDelete: Restrict` sur les trois relations : aucune suppression physique
/// de Client/Property/Tariff n'est possible depuis l'app tant qu'une
/// réservation les référence (voir la mise à jour de deleteTariff()).
model Reservation {
  id String @id @default(cuid())

  /// Lot "Reservation — Client facultatif" : nullable depuis ce lot — un
  /// séjour court (<48h, seuil partagé avec lib/identity.ts
  /// IDENTITY_REQUIRED_THRESHOLD_HOURS) peut être créé sans client. Un
  /// séjour >=48h continue d'exiger un client, imposé côté serveur
  /// (createReservation/updateReservation), jamais seulement par l'absence
  /// de contrainte ici.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  /// Jour calendaire de l'arrivée (affichage/filtrage "aujourd'hui/à venir").
  date DateTime

  /// Instants exacts (date + heure) — utilisés pour le calcul réel de
  /// disponibilité ; `departureTime` peut retomber le lendemain.
  arrivalTime   DateTime
  departureTime DateTime

  /// Copie figée depuis Tariff au moment de la création — jamais recalculée.
  durationValue Int
  durationUnit  DurationUnit
  amount        Int

  deposit       Int            @default(0)
  depositMethod PaymentMethod?

  status ReservationStatus @default(CONFIRMED)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Présent seulement si "Faire entrer" a été exécuté (Phase 7). Le lien
  /// est conservé indéfiniment : la réservation reste l'historique de
  /// l'origine de la location, elle n'est jamais supprimée.
  rental Rental?

  /// Paiements encaissés PENDANT que ce contexte était une réservation
  /// (avant toute arrivée). Voir le commentaire sur `model Payment` pour la
  /// règle anti double-comptage une fois qu'une Rental existe.
  payments Payment[]

  @@index([propertyId, status])
  @@index([clientId])
  @@index([arrivalTime])
  @@index([status])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 7 — Locations (Rental)
// ---------------------------------------------------------------------------

enum RentalStatus {
  /// Client actuellement dans le logement — bloque la disponibilité.
  ACTIVE
  /// Séjour terminé normalement — ne bloque plus, reste en historique.
  COMPLETED
  /// Annulée avant sa fin — ne bloque plus, reste en historique.
  CANCELLED
}

/// Un client réellement présent dans un logement — distinct d'une
/// Reservation (un créneau réservé pour le futur). Créée soit depuis une
/// réservation CONFIRMED ("Faire entrer"), soit directement ("Nouvelle
/// location", sans réservation).
///
/// `tariffId` est nullable (comme demandé) : les deux parcours actuels de
/// l'app renseignent toujours un tarif, mais le modèle n'exige pas qu'un
/// tarif existe pour toute location possible à l'avenir.
///
/// `onDelete: Restrict` partout : jamais de suppression physique de
/// Client/Property/Reservation/Tariff tant qu'une location les référence.
/// Une Rental elle-même n'est également jamais supprimée physiquement par
/// l'app — seul son statut change (voir RentalStatus).
model Rental {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  /// Une location directe n'a pas de réservation d'origine.
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  tariffId String?
  tariff   Tariff? @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  /// Heure RÉELLE d'arrivée — peut différer de l'heure prévue de la
  /// réservation d'origine, qui elle reste inchangée pour toujours (Bloc 9).
  /// Depuis le Bloc 21 (arrivée rétroactive), peut aussi différer de
  /// `registeredAt` : un gestionnaire peut saisir une arrivée jusqu'à 24h
  /// dans le passé (voir src/lib/retroactive-checkin.ts) — c'est TOUJOURS
  /// cette valeur-ci (jamais `registeredAt`) qui sert au calcul du départ et
  /// à la vérification de disponibilité.
  arrivalAt DateTime

  /// Calculée à la création depuis arrivalAt + durée, puis déplacée par
  /// chaque prolongation (jamais par une simple édition).
  plannedDepartureAt DateTime
  actualDepartureAt  DateTime?

  /// Copie figée au moment de la création (depuis le Tariff choisi, ou
  /// depuis la Reservation d'origine si applicable) — jamais recalculée.
  durationValue Int
  durationUnit  DurationUnit

  /// Montant total COURANT = montant initial + somme des RentalExtension.
  /// Incrémenté à chaque prolongation, jamais écrasé (Bloc 15).
  amount Int

  /// Repris tel quel depuis la Reservation d'origine si applicable
  /// (Bloc 16) — jamais redemandé au gestionnaire dans ce cas.
  deposit Int @default(0)

  status RentalStatus @default(ACTIVE)
  note   String?

  /// Bloc 21/Bloc 15 (traçabilité) — `registeredByUserId` reste NULL sur les
  /// lignes créées avant ces fonctionnalités (jamais fabriqué a posteriori —
  /// voir Phase "audit financier", section W : il n'existait aucune
  /// traçabilité d'auteur avant ce bloc). Pour toute nouvelle Rental, il est
  /// systématiquement renseigné, que l'arrivée soit rétroactive ou non.
  /// `retroactiveReason` n'est renseigné QUE lorsque `arrivalAt` est
  /// réellement rétroactif (hors tolérance technique) — jamais pour une
  /// arrivée "maintenant". `createdAt` (déjà existant ci-dessous) EST
  /// l'unique timestamp d'enregistrement — un champ `registeredAt` dédié
  /// existait un temps mais a été retiré (Bloc 15) : doublon exact de
  /// `createdAt` pour toute nouvelle ligne, qu'il n'y avait aucune raison de
  /// maintenir séparément.
  registeredByUserId String?
  registeredBy       User?   @relation("RentalRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  retroactiveReason  String?

  /// Depuis le Bloc 15 (traçabilité), ce champ standard Prisma porte
  /// explicitement le sens métier "quand la location a été enregistrée dans
  /// SAMA HOME" — distinct de `arrivalAt` (l'heure RÉELLE d'arrivée,
  /// potentiellement jusqu'à 24h antérieure).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extensions RentalExtension[]

  /// Paiements encaissés PENDANT que ce contexte était une location (après
  /// l'arrivée). Pour une location née d'une réservation, le total réel payé
  /// additionne CES paiements-ci ET ceux de la réservation d'origine — voir
  /// src/lib/payment-summary.ts. `Rental.deposit` reste un champ historique
  /// figé (Bloc 2 de la Phase 8) : pour une location née d'un check-in, ce
  /// n'est qu'une COPIE de `Reservation.deposit`, jamais un paiement
  /// distinct — donc jamais reconverti en Payment séparément (voir
  /// prisma/backfill-payments.ts).
  payments Payment[]

  @@index([propertyId, status])
  @@index([clientId])
  @@index([status])
  @@index([establishmentId])
}

/// Journal append-only d'une prolongation (Bloc 15) : préserve le détail de
/// CHAQUE extension au lieu d'écraser un seul total, pour ne jamais perdre
/// l'historique si plusieurs prolongations sont accordées. Ce n'est pas un
/// système financier (pas de Payment/caisse/rapprochement) — seulement la
/// trace de comment Rental.amount a grandi dans le temps.
model RentalExtension {
  id       String @id @default(cuid())
  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  durationValue Int
  durationUnit  DurationUnit
  amount        Int

  createdAt DateTime @default(now())

  @@index([rentalId])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 8 — Paiements (Payment)
// ---------------------------------------------------------------------------

/// Un encaissement réel, saisi une fois, jamais modifié ni supprimé après
/// coup (Bloc 16) — la seule correction prévue pour V1 est une phase
/// financière ultérieure (contre-écriture), volontairement hors périmètre
/// ici.
///
/// EXACTEMENT UN des deux (reservationId, rentalId) doit être renseigné —
/// jamais les deux, jamais aucun. Contrainte appliquée à la fois côté
/// application (src/app/actions/payments.ts) ET côté base (contrainte CHECK
/// ajoutée à la migration `add_payments`) : Bloc 4 demandait "au minimum un
/// contexte valide", mais autoriser les deux à la fois romprait justement la
/// règle anti double-comptage que ce même bloc demande de préserver (un
/// paiement rattaché simultanément à une réservation ET à une location
/// apparaîtrait dans les deux résumés financiers) — durcir "au minimum" en
/// "exactement" est documenté ici plutôt que décidé silencieusement.
///
/// Pas de suppression physique de Reservation/Rental tant qu'un paiement les
/// référence (onDelete: Restrict), comme pour toutes les autres relations du
/// projet vers ces deux modèles.
///
/// Rattachement réservation → location (Bloc 19) : un paiement encaissé
/// AVANT l'arrivée reste lié à `reservationId` pour toujours (jamais
/// migré/déplacé vers `rentalId` au moment du check-in). Le total payé
/// d'une location née d'une réservation additionne donc les deux ensembles
/// (voir src/lib/payment-summary.ts), sans qu'aucune ligne ne soit jamais
/// comptée dans les deux totaux à la fois.
model Payment {
  id String @id @default(cuid())

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  rentalId String?
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  amount Int
  method PaymentMethod

  /// Toujours l'heure serveur au moment de l'encaissement (Bloc 11) — jamais
  /// une valeur envoyée par le navigateur. Aucune UI ne permet de saisir une
  /// date historique pour V1.
  paidAt DateTime @default(now())

  reference String?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([rentalId])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 9 — Dépenses (Expense)
// ---------------------------------------------------------------------------

/// Catégorie de dépense configurable par l'ADMIN (Bloc 16.1) — remplace
/// l'ancien enum `ExpenseCategory` figé dans le code. Même forme que
/// `Tariff` (seul précédent réel de ce genre dans ce projet) : `active`
/// archive sans supprimer, pas de suppression physique si référencée
/// (`onDelete: Restrict` sur `Expense.category`), pas de contrainte
/// d'unicité sur `name` (une catégorie désactivée et son remplacement actif
/// peuvent légitimement partager le même nom — même raisonnement que
/// `Tariff.label`). `position` pilote l'ordre d'affichage dans
/// Paramètres → Catégories de dépenses (Bloc 16.2, pas encore implémenté).
model ExpenseCategory {
  id       String  @id @default(cuid())
  name     String
  active   Boolean @default(true)
  position Int     @default(0)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([active, position])
  @@index([establishmentId])
}

/// Argent SORTANT de l'activité — jamais mélangé avec `Payment` (argent
/// ENTRANT), voir Bloc 1 de la Phase 9. Pas de relation vers Property : une
/// dépense (loyer, électricité, salaire...) concerne généralement toute la
/// résidence, pas un logement précis, et rien dans le périmètre de la Phase
/// 9 ne demande de filtrer/imputer une dépense à un logement — inventer
/// cette relation aurait été une décision métier non demandée (Bloc 3).
///
/// Comme `Payment`, `method` réutilise l'enum `PaymentMethod` existant (même
/// vocabulaire technique — "comment l'argent a bougé" — appliqué ici au sens
/// sortant plutôt qu'entrant), aucune deuxième enum créée (Bloc 6).
///
/// Historique, jamais modifiée ni supprimée physiquement après création
/// (Bloc 15/16) : aucune action de modification/suppression n'existe dans
/// le code applicatif pour ce modèle.
model Expense {
  id String @id @default(cuid())

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  /// Copie figée du nom de la catégorie au moment de la création (Bloc
  /// 16.1) — un renommage ultérieur de `ExpenseCategory.name` ne doit
  /// jamais changer rétroactivement l'affichage d'une dépense déjà
  /// enregistrée. `categoryId` reste la seule référence structurelle
  /// (filtres, intégrité, rattachement) ; ce champ n'est qu'un libellé
  /// historique figé, jamais utilisé pour filtrer/agréger.
  categoryNameSnapshot String

  amount Int

  /// Toujours l'heure serveur au moment de la création (Bloc 7) — jamais une
  /// valeur envoyée par le navigateur. Aucune UI ne permet de saisir une
  /// dépense à une date historique pour V1.
  paidAt DateTime @default(now())

  method    PaymentMethod
  reference String?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidAt])
  @@index([categoryId])
  @@index([method])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Phase 11 — Paramètres (Settings)
// ---------------------------------------------------------------------------

/// Informations générales de l'établissement (Bloc 4/5). Nécessaire :
/// aucun modèle existant ne porte ces données (Property est par logement,
/// pas pour la résidence dans son ensemble).
///
/// Singleton délibéré À L'ORIGINE : un seul enregistrement, toujours lu/écrit
/// via `id = "singleton"` (voir src/lib/settings-data.ts et
/// src/app/actions/settings.ts) — convention APPLICATIVE uniquement, jamais
/// imposée par le schéma (`id` est un `cuid()` ordinaire, rien n'empêchait
/// déjà une deuxième ligne). Lot multi-tenant : `establishmentId` (nullable
/// dans cette Phase 1, deviendra `@unique` non nul après le backfill) portera
/// désormais une ligne par établissement, remplaçant `SETTINGS_ID` — pas
/// un changement de structure, une clarification de ce qui était déjà vrai.
///
/// `logoUrl` (lot "Apparence & Logo", puis "Téléversement durable des
/// images") : même convention que `Property.photo` — une clé d'objet du
/// Bucket Railway (nouveau mode) ou, pour toute donnée antérieure à ce
/// second lot, un lien http(s) collé directement (ancien mode V1, conservé
/// tel quel). Résolu en URL d'affichage (src/app/settings/page.tsx) ou en
/// octets bruts pour le contrat PDF (src/lib/contract-data.ts) via
/// src/lib/object-storage.ts — jamais une URL transmise telle quelle au
/// générateur PDF (bucket privé, pas d'accès réseau direct possible). Le
/// logo OFFICIEL SAMA HOME (fichier statique dans public/brand/, affiché sur
/// la page Paramètres) reste distinct et non modifiable : celui-ci est le
/// logo propre de l'établissement exploitant l'application.
model Settings {
  id String @id @default(cuid())

  /// Lot multi-tenant / Phase 3F Lot D12-C — rendu obligatoire après
  /// confirmation que le backfill (Phase 2B) a bien rattaché l'unique ligne
  /// existante à son établissement : une ligne de paramètres par
  /// établissement, jamais partagée.
  establishmentId String       @unique
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  establishmentName String
  phone             String
  secondaryPhone    String?
  address           String
  email             String?
  description       String?
  logoUrl           String?

  /// Lot "Personnalisation des couleurs" — palette de marque personnalisée,
  /// au niveau de l'établissement (comme `logoUrl`). NULL sur les trois
  /// colonnes = couleurs par défaut SAMA HOME (#12304A / #E5484D / #F59E0B),
  /// résolues au moment de la lecture, jamais écrites en dur ici. Les trois
  /// colonnes sont toujours NULL ensemble ou renseignées ensemble (contrainte
  /// CHECK en migration) : l'interface propose des palettes complètes
  /// prédéfinies, jamais un remplacement partiel d'une seule des trois
  /// couleurs qui casserait la cohérence déjà validée (contraste) de la
  /// palette. Indépendant des jetons sémantiques (succès/erreur/avertissement/
  /// information) et du thème clair/sombre, qui restent inchangés.
  primaryColor   String?
  secondaryColor String?
  accentColor    String?

  /// Message WhatsApp personnalisé pour les confirmations
  whatsappTemplate      String?
  /// Seuil de jours à partir duquel le contrat PDF et la pièce d'identité sont exigés (par défaut 1 jour)
  contractThresholdDays Int?     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Bloc 15 — Traçabilité (AuditLog)
// ---------------------------------------------------------------------------

/// Journal générique des opérations sensibles — répond à "quelle opération a
/// été effectuée, sur quelle donnée, avec quelles anciennes/nouvelles
/// valeurs, éventuellement pour quelle raison". Complémentaire, pas
/// redondant, avec un champ "auteur" direct sur une entité (ex.
/// `Rental.registeredByUserId`, qui répond seulement à "qui a créé CETTE
/// ligne") : AuditLog peut couvrir plusieurs types d'opérations sur
/// plusieurs entités dans le temps, modifications comprises, pas seulement
/// la création.
///
/// Portée volontairement minimale pour cette étape (Bloc 7/10) : seules les
/// créations de Rental (location directe, check-in) sont journalisées pour
/// l'instant. D'autres opérations (tarifs, dépenses, versements...)
/// viendront s'ajouter progressivement, sans changement de structure ici.
///
/// `oldValue`/`newValue` en `Json?` : instantané structuré plutôt qu'une
/// chaîne — type Postgres/Prisma déjà standard, pas une nouvelle convention
/// inventée. `null` pour `oldValue` sur une création (rien n'existait avant).
///
/// Lot multi-tenant : `establishmentId` nullable — renseigné pour une
/// action métier *au sein* d'un établissement, non pertinent pour une
/// décision de plateforme (approbation/refus d'un établissement), où
/// `entityId` identifie déjà la cible sans ambiguïté.
model AuditLog {
  id String @id @default(cuid())

  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  /// Phase 3G / Lot D12-P88 — nullable : `NULL` signifie une action
  /// déclenchée par le SYSTÈME, sans acteur humain réel (ex.
  /// `ESTABLISHMENT_AUTO_APPROVED`, créé par `registerEstablishment()`
  /// elle-même, une action PUBLIQUE sans utilisateur authentifié — jamais
  /// un acteur humain fabriqué pour satisfaire une contrainte NOT NULL).
  /// Tout journal déjà existant, créé par une action humaine réelle,
  /// conserve son `userId` réel, inchangé par cette migration additive.
  userId String?
  user   User?   @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Restrict)

  action     String
  entityType String
  entityId   String

  reason    String?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Bloc 17.2 — Caisse & Banque
// ---------------------------------------------------------------------------

/// La caisse physique/logique. V1 (Bloc 17.1, décision A) : une seule ligne
/// utilisée. Une vraie table dès maintenant (pas un singleton à id fixe
/// comme `Settings`) pour qu'une future caisse supplémentaire n'exige
/// aucune migration structurelle — seulement une nouvelle ligne.
model CashRegister {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions CashSession[]

  @@index([active])
  @@index([establishmentId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Une période OUVERTURE → CLÔTURE pour une caisse. Le solde théorique
/// n'est JAMAIS stocké pendant que la session est OPEN (calculé à la
/// demande — voir src/lib/cash-data.ts, Bloc 17.2 section D) : seul
/// `closingTheoreticalBalance` est écrit, une seule fois, au moment de la
/// clôture — même principe que `Reservation.amount` figé depuis `Tariff`
/// au moment de la création, jamais recalculé après coup.
///
/// Contrainte "une seule session OPEN par caisse" : non exprimable dans ce
/// schéma (pas de preview feature d'index partiel activé dans ce projet —
/// voir generator ci-dessus) — appliquée via un index unique partiel ajouté
/// à la main dans la migration SQL (même technique déjà utilisée pour
/// `Payment_context_check`), doublée d'une vérification applicative dans la
/// transaction Serializable d'ouverture.
model CashSession {
  id String @id @default(cuid())

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  status CashSessionStatus @default(OPEN)

  /// Bloc 17.1 décision I / Bloc 17.2 section 3.3 : normalement copié du
  /// `physicalCount` (s'il existe) sinon du `closingTheoreticalBalance` de
  /// la session précédente. `openingIsManual`/`openingReason` ne sont
  /// renseignés que pour l'ouverture exceptionnelle ADMIN (première
  /// ouverture, ou override).
  openingBalance  Int
  openingIsManual Boolean @default(false)
  openingReason   String?
  openedAt        DateTime @default(now())
  openedByUserId  String
  openedBy        User     @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)

  /// Figé une seule fois à la clôture — jamais recalculé après coup, même
  /// si une correction est ajoutée plus tard (voir modification de clôture,
  /// Bloc 17.2 section 14, qui ne touche jamais ce champ).
  closingTheoreticalBalance Int?
  /// Comptage physique — facultatif (Bloc 17.1 décision D).
  physicalCount             Int?
  /// `physicalCount - closingTheoreticalBalance`, renseigné seulement si
  /// `physicalCount` est fourni.
  variance                  Int?
  /// Obligatoire dès que `variance != 0` (Bloc 17.1 décision E) — jamais
  /// bloquant pour la clôture elle-même.
  varianceReason            String?
  closeNote                 String?
  closedAt                  DateTime?
  closedByUserId            String?
  closedBy                  User?     @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections   CashCorrection[]
  bankTransfers BankTransfer[]

  @@index([cashRegisterId, status])
  @@index([openedAt])
  @@index([closedAt])
  @@index([establishmentId])
}

/// La SEULE ligne financière saisie manuellement dans toute cette
/// architecture (Bloc 17.1 section 6) — un ajustement explicite quand la
/// caisse réelle ne correspond à aucune opération déjà enregistrée. ADMIN
/// uniquement (Bloc 17.2 section 3.1). `amount` signé (+/-). Append-only :
/// aucune action de modification/suppression ne doit jamais être écrite
/// pour ce modèle — une correction erronée s'annule par une NOUVELLE ligne
/// de signe opposé, jamais en silence (même philosophie que
/// `Payment`/`Expense`/`RentalExtension`).
model CashCorrection {
  id String @id @default(cuid())

  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  amount Int
  reason String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([cashSessionId])
  @@index([userId])
  @@index([establishmentId])
}

/// Référence d'un compte bancaire externe — jamais de données sensibles en
/// clair (Bloc 17.2 section 7) : `maskedAccountNumber` est une chaîne déjà
/// masquée (ex. "•••• 4821"), jamais un numéro complet ni un IBAN, jamais
/// d'identifiants d'accès. Mono-devise FCFA comme tout le reste du projet
/// (`Int`, jamais de `Float`/`Decimal`) — aucun champ devise ajouté. Même
/// forme `active`/pas de suppression physique si référencé que
/// `Tariff`/`ExpenseCategory` : ADMIN uniquement pour créer/modifier/
/// désactiver (Bloc 17.2 section 3.2).
model BankAccount {
  id                   String  @id @default(cuid())
  label                String
  bankName             String
  maskedAccountNumber  String?
  active               Boolean @default(true)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfers BankTransfer[]
  schedules TransferSchedule[]

  @@index([active])
  @@index([establishmentId])
}

enum BankTransferStatus {
  DRAFT
  SCHEDULED
  EFFECTED
  CANCELLED
}

/// CAISSE → BANQUE. Jamais une `Expense` — table structurellement séparée,
/// donc impossible à confondre avec une dépense (Bloc 17.1 section 2/
/// Bloc 17.2 section 3.2). `cashSessionId` n'est résolu qu'au moment de
/// l'EFFET réel (jamais à la création d'un DRAFT/SCHEDULED, qui peut exister
/// avant même qu'une session ne soit ouverte) — même principe que
/// `Reservation.arrivalTime` (prévu) vs `Rental.arrivalAt` (réel) déjà
/// établi dans ce projet : ne jamais confondre une intention planifiée avec
/// un fait réellement survenu.
model BankTransfer {
  id String @id @default(cuid())

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  amount Int
  status BankTransferStatus @default(DRAFT)

  scheduledAt DateTime?
  effectedAt  DateTime?

  reference String?
  note      String?

  createdByUserId String
  createdBy       User   @relation("BankTransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  effectedByUserId String?
  effectedBy       User?   @relation("BankTransferEffectedBy", fields: [effectedByUserId], references: [id], onDelete: Restrict)

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  /// Présent uniquement si généré automatiquement par une TransferSchedule
  /// échue — traçabilité directement portée par ce champ (Bloc 17.2 section
  /// 20 : pas d'utilisateur système inventé, pas d'AuditLog pour la simple
  /// génération, seulement pour les actions humaines réelles).
  transferScheduleId String?
  transferSchedule   TransferSchedule? @relation(fields: [transferScheduleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transferScheduleId, scheduledAt], map: "BankTransfer_schedule_date_unique")
  @@index([bankAccountId])
  @@index([cashSessionId])
  @@index([status])
  @@index([transferScheduleId])
  @@index([establishmentId])
}

enum TransferFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TransferAmountType {
  FIXED
  PERCENTAGE
}

/// Une règle de récurrence qui GÉNÈRE des `BankTransfer` à l'état
/// `SCHEDULED` — ne les exécute jamais elle-même (Bloc 17.1 section 9 /
/// Bloc 17.2 section 3.5 : "une programmation ne doit jamais prétendre
/// avoir effectué automatiquement un transfert bancaire"). ADMIN uniquement
/// pour créer/modifier/désactiver (Bloc 17.2 section 3.2). Déclenchement
/// lazy (vérifié à la consultation d'une page pertinente, voir Bloc 17.2
/// section 18) — ce projet n'a aucune infrastructure de tâche planifiée.
model TransferSchedule {
  id String @id @default(cuid())

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  /// Lot multi-tenant — nullable dans cette Phase 1 (migration additive),
  /// deviendra obligatoire après le backfill des données existantes.
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  frequency  TransferFrequency
  amountType TransferAmountType

  /// Exactement un des deux selon `amountType` — jamais les deux à la fois
  /// (contrainte CHECK ajoutée en migration, même style que
  /// `Payment_context_check`).
  fixedAmount Int?
  /// Pourcentage de la trésorerie théorique disponible au moment de la
  /// génération (Bloc 17.2 section 3.4/19) — jamais un pourcentage figé
  /// d'un montant historique.
  percentage  Int?

  nextRunAt DateTime
  /// Lot "Virements mensuels — ancre durable" : jour du mois (1-31)
  /// voulu par l'utilisateur, préservé indépendamment du clampage de
  /// `nextRunAt` par des mois plus courts (ex. ancre 31, `nextRunAt`
  /// ramené à 28 en février — l'ancre reste 31 pour redevenir effective
  /// dès un mois qui le permet). Recalculé uniquement quand `nextRunAt`
  /// est explicitement modifié par un humain (création, ou modification
  /// manuelle de la date) — jamais par le rattrapage automatique
  /// (`catchUpSchedule`), jamais par une simple modification du montant.
  /// Nullable pour les lignes créées avant ce lot (contrainte CHECK en
  /// migration, même style que `TransferSchedule_amount_type_check`) ;
  /// `advanceNextRunAt` retombe sur l'ancien comportement (dérivé de
  /// `nextRunAt`) tant qu'il est absent.
  anchorDay Int?
  active    Boolean  @default(true)

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedTransfers BankTransfer[]

  @@index([bankAccountId])
  @@index([active, nextRunAt])
  @@index([establishmentId])
}

// ---------------------------------------------------------------------------
// Multi-tenant — Administration de la plateforme, notifications, abonnements
// (Phase 1 : schéma additif uniquement — aucune donnée créée ici)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  INTERNAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Couvre à la fois les e-mails (suivi d'envoi : `status`/`attempts`/
/// `lastError`) et les notifications internes de plateforme (suivi de
/// lecture individuel via `NotificationRead`, par administrateur de
/// plateforme — jamais un état de lecture partagé). Écrite dans la MÊME
/// transaction que l'événement qui la déclenche (inscription, approbation,
/// refus, suspension, réactivation) — son statut d'envoi reste toujours
/// découplé de l'opération métier : un échec d'e-mail ne modifie jamais
/// `Establishment.status` ni `Subscription`.
model Notification {
  id      String              @id @default(cuid())
  channel NotificationChannel
  /// Ex. "ESTABLISHMENT_SIGNUP" | "ESTABLISHMENT_APPROVED" |
  /// "ESTABLISHMENT_REJECTED" | "ESTABLISHMENT_SUSPENDED" |
  /// "ESTABLISHMENT_REACTIVATED" | "SUBSCRIPTION_EXPIRING_SOON" — chaîne
  /// libre volontairement (pas un enum) : la liste des événements évoluera
  /// sans migration de schéma à chaque ajout.
  event   String

  relatedEstablishmentId String?
  relatedEstablishment   Establishment? @relation(fields: [relatedEstablishmentId], references: [id], onDelete: Restrict)

  /// Renseigné uniquement si `channel = EMAIL` — jamais un secret.
  recipientEmail String?
  subject        String

  status   NotificationStatus @default(PENDING)
  /// Incrémenté à chaque nouvelle tentative — une tentative MET À JOUR
  /// cette même ligne, ne crée jamais de ligne dupliquée pour le même
  /// événement (idempotence des relances, par construction).
  attempts Int                @default(0)
  /// Message sûr uniquement (ex. nom de l'erreur) — jamais une trace
  /// complète susceptible de révéler une configuration sensible, même
  /// principe déjà appliqué à deleteImageObject() (src/lib/object-storage.ts).
  lastError String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  reads NotificationRead[]

  @@index([channel, status])
  @@index([relatedEstablishmentId])
}

/// État de lecture INDIVIDUEL par administrateur de plateforme — la
/// `Notification` elle-même reste une ligne unique et partagée (traçabilité
/// intacte, voir aussi `AuditLog` pour l'historique des décisions), seule
/// la lecture devient personnelle. "Non lu pour MOI" = absence de ligne ici
/// pour (notificationId, mon userId). `onDelete: Cascade` sur
/// `notificationId` (seule exception au `Restrict` sinon systématique dans
/// ce schéma) : un reçu de lecture n'a aucune signification indépendante de
/// la notification qu'il concerne, contrairement à toute donnée métier.
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  readAt DateTime @default(now())

  @@id([notificationId, userId])
}

/// Un abonnement par établissement — créé UNIQUEMENT au moment de
/// l'approbation (jamais à l'inscription : l'essai démarre à la date
/// d'approbation, décision produit validée), dans la même transaction que
/// le passage de `Establishment.status` à `ACTIVE`.
///
/// Volontairement AUCUN champ "status" stocké : l'état effectif (en essai /
/// payant actif / expiré) est entièrement DÉRIVÉ de la comparaison entre
/// `currentPeriodEnd` et l'instant présent — ce projet n'a aucune tâche
/// planifiée pour faire basculer activement un tel champ, qui risquerait
/// de diverger silencieusement de la réalité. `currentPeriodEnd` est la
/// seule source de vérité sur l'accès aux fonctionnalités payantes —
/// vérifiée SEULEMENT après que `Establishment.status === ACTIVE` (axes
/// indépendants, jamais fusionnés).
model Subscription {
  id              String @id @default(cuid())
  establishmentId String @unique
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  trialStartedAt   DateTime
  currentPeriodEnd DateTime

  /// Idempotence du rappel d'expiration (déclenché à la demande, à
  /// l'ouverture du tableau de bord plateforme — aucune tâche planifiée
  /// dans ce projet) : un rappel n'est créé pour la période courante que si
  /// cette valeur diffère de `currentPeriodEnd`. Une confirmation de
  /// paiement qui avance `currentPeriodEnd` réarme naturellement
  /// l'éligibilité à un rappel pour la PROCHAINE période, sans jamais
  /// renvoyer un rappel déjà émis pour la période déjà traitée.
  reminderSentForPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]

  @@index([currentPeriodEnd])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// Historique append-only des paiements d'abonnement — jamais écrasé.
/// Confirmation UNIQUEMENT manuelle par un administrateur de plateforme
/// (décision produit validée : jamais un simple retour de navigateur
/// considéré comme une preuve de paiement). Double confirmation/double
/// prolongation empêchée au niveau applicatif par un `updateMany` filtré
/// sur `status: PENDING` (même mécanisme déjà utilisé par
/// updateSettings()/saveBrandColors() de ce projet) — jamais seulement une
/// vérification lue puis agie séparément, qui laisserait une fenêtre de
/// course concurrente.
model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  /// FCFA entier — même convention que Tariff.amount/Payment.amount.
  amount       Int
  /// 3 aujourd'hui (voir PricingSettings ci-dessous) — jamais codé en dur
  /// dans la logique de prolongation, toujours lu depuis cette ligne.
  periodMonths Int
  status       PaymentStatus @default(PENDING)
  /// Justificatif libre (référence de virement/mobile money) — jamais un
  /// numéro de carte ni un secret.
  reference    String?

  confirmedByUserId String?
  confirmedBy       User?   @relation("SubscriptionPaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  /// Renseignés uniquement à la confirmation — jamais avant.
  periodStartedAt DateTime?
  periodEndedAt   DateTime?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([subscriptionId])
  @@index([status])
}

/// Paramètres de tarification à l'échelle de TOUTE la plateforme — à ne
/// jamais confondre avec `Settings`, qui reste propre à chaque établissement.
/// Modifiable uniquement par un administrateur de plateforme.
///
/// Correction (audit Phase 1.1/1.2) : contrairement à l'ancienne convention
/// de `Settings` (jamais imposée par le schéma), l'unicité d'une seule ligne
/// est ici RÉELLEMENT garantie en base — `id` est un identifiant fixe
/// (`'singleton'`), verrouillé par une contrainte CHECK ajoutée à la main en
/// migration (`PricingSettings_singleton_check`), même technique déjà
/// utilisée dans ce projet pour `Settings_brand_colors_all_or_none_check`.
/// Toute tentative d'insertion avec un autre id est rejetée par le CHECK ;
/// toute tentative avec le même id est rejetée par l'unicité de la clé
/// primaire déjà existante.
model PricingSettings {
  id                  String   @id @default("singleton")
  trialDurationMonths Int      @default(2)
  periodMonths        Int      @default(3)
  periodPriceFcfa     Int      @default(9900)
  updatedAt           DateTime @updatedAt
}

/// Réglages globaux de PLATEFORME — Phase 3G / Lot D12-P88 — distinct de
/// `PricingSettings` ci-dessus (qui reste strictement tarifaire ; mélanger
/// un réglage de workflow dans une table nommée "Pricing" aurait été
/// trompeur, signalé comme choix lors de l'audit D12-P87). Même technique
/// de singleton verrouillé par contrainte CHECK réelle en base
/// (`PlatformSettings_singleton_check`) que `PricingSettings` ci-dessus.
/// Modifiable uniquement par un administrateur de plateforme
/// (`requirePlatformAdmin()`), jamais par un ADMIN d'établissement.
model PlatformSettings {
  id String @id @default("singleton")

  /// Mode manuel par défaut (`false`) — une inscription publique
  /// (`registerEstablishment()`) reste `PENDING` tant qu'un administrateur
  /// de plateforme ne l'approuve pas explicitement. Si `true`,
  /// `registerEstablishment()` approuve l'établissement et crée son
  /// abonnement d'essai directement, dans la MÊME transaction que
  /// l'inscription elle-même — jamais un `PENDING` intermédiaire visible.
  /// Basculer ce réglage ne modifie jamais un établissement déjà existant.
  autoApproveEstablishments Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Vérification d'adresse e-mail par code OTP à 6 chiffres pour les nouveaux utilisateurs
model OtpVerification {
  id                String   @id @default(cuid())
  email             String
  code              String
  establishmentName String
  managerName       String
  passwordHash      String
  plan              String   @default("FREE_TRIAL")
  expiresAt         DateTime
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([email])
}

/// Jeton et code OTP sécurisé pour la réinitialisation de mot de passe oublié
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  code      String   /// Code à 6 chiffres
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

