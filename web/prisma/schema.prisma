// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 2 — Authentification
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  GESTIONNAIRE
}

model User {
  id           String   @id @default(cuid())
  /// Identifiant de connexion (voir écran "Splash / Connexion" de la maquette)
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(GESTIONNAIRE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

/// Session serveur (DB-backed) : la valeur en base fait autorité, le cookie
/// n'est qu'une référence signée vers elle (voir src/lib/session.ts).
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Clients
// ---------------------------------------------------------------------------

/// `idDocumentType` reste une chaîne libre (pas un enum) : le prompt maître
/// n'énumère pas les types de pièce acceptés, et les figer maintenant serait
/// inventer une règle métier non demandée. L'UI suggère quelques valeurs
/// courantes via des puces, sans empêcher la saisie libre.
model Client {
  id    String @id @default(cuid())
  name  String
  /// Normalisé à la création/modification (espaces/points/tirets retirés,
  /// "+" initial conservé) pour que la recherche soit fiable — voir
  /// src/lib/definitions.ts, ClientSchema.
  phone String

  email            String?
  address          String?
  idDocumentType   String?
  idDocumentNumber String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payment appartient à une phase suivante ; elle ajoutera sa propre
  // relation vers Client sans modifier ce modèle davantage.
  reservations Reservation[]
  rentals      Rental[]

  @@index([phone])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Phase 4 — Logements
// ---------------------------------------------------------------------------

enum PropertyType {
  ROOM
  APARTMENT
}

/// Un logement (chambre meublée ou appartement).
///
/// Volontairement PAS de colonne "status" : le prompt maître interdit un
/// statut manuel qui pourrait contredire les futures réservations/locations.
/// Le statut affiché (AVAILABLE/OCCUPIED/RESERVED/UNAVAILABLE) est calculé à
/// la volée par src/lib/property-status.ts à partir de `active`, des
/// réservations CONFIRMED proches et des locations ACTIVE (Phase 7) — sans
/// qu'aucune colonne supplémentaire n'ait été ajoutée ici.
///
/// `photo` est une simple URL (String?) collée par le gestionnaire : pas
/// d'upload de fichier, pas de service de stockage externe, conformément à
/// la consigne de la Phase 4 ("ne pas ajouter Cloudinary/S3 sans besoin réel").
model Property {
  id          String       @id @default(cuid())
  name        String
  type        PropertyType
  description String?
  capacity    Int
  photo       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tariffs      Tariff[]
  reservations Reservation[]
  rentals      Rental[]

  @@index([type])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Phase 5 — Tarifs
// ---------------------------------------------------------------------------

/// Catégorie tarifaire (vocabulaire métier, français). Base V1 imposée par le
/// prompt maître — ne pas en ajouter sans le signaler d'abord.
enum TariffType {
  HEURE
  NUIT
  JOUR
  SEMAINE
  MOIS
}

/// Unité de la durée (vocabulaire technique, anglais — délibérément distinct
/// de TariffType). Ce découplage EST la règle métier critique de la Phase 5 :
/// une durée de 24 HOURS n'est pas automatiquement un tarif JOUR, et un tarif
/// JOUR peut être exprimé en 1 DAY ou en 24 HOURS selon le choix du
/// gestionnaire. Aucune contrainte ne force un couplage type/unité.
enum DurationUnit {
  HOURS
  NIGHT
  DAY
  WEEK
  MONTH
}

/// Un tarif appartient toujours à un logement. `amount` en FCFA entier (pas
/// de sous-unité dans cette devise) : jamais de Float JS, jamais de Decimal
/// inutile pour une devise qui n'a pas de centimes.
///
/// Pas de contrainte d'unicité en base sur (propertyId, type, durationValue,
/// durationUnit) : elle casserait l'historique (un ancien tarif désactivé et
/// son remplaçant actif partagent forcément cette combinaison). La
/// prévention des doublons actifs est applicative — voir
/// src/app/actions/tariffs.ts.
///
/// Pas de suppression automatique : `active` est le mécanisme d'archivage
/// prévu pour que la Phase 6 (Réservations) puisse un jour référencer un
/// tarif historique sans qu'il ait disparu. La suppression physique reste
/// possible ici (rien ne référence encore Tariff) mais devra être bloquée
/// par la Phase 6 dès qu'une réservation peut pointer vers un tarif — voir
/// le commentaire dans deleteTariff().
model Tariff {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyId String

  label         String
  type          TariffType
  durationValue Int
  durationUnit  DurationUnit
  amount        Int
  active        Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  rentals      Rental[]

  @@index([propertyId])
  @@index([propertyId, active])
}

// ---------------------------------------------------------------------------
// Phase 6 — Réservations
// ---------------------------------------------------------------------------

enum ReservationStatus {
  CONFIRMED
  /// Atteignable uniquement par une future phase Locations (arrivée réelle).
  ARRIVED
  CANCELLED
  /// Atteignable uniquement par une future phase Locations (séjour terminé).
  COMPLETED
}

/// Vocabulaire déjà donné dans le prompt maître d'origine (section 21) —
/// réutilisé ici pour `depositMethod`, pas inventé.
enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  OTHER
}

/// Une réservation. `amount`, `durationValue` et `durationUnit` sont des
/// COPIES figées au moment de la création (voir src/app/actions/reservations.ts) :
/// si le Tariff référencé est modifié plus tard, cette réservation ne doit
/// jamais être recalculée rétroactivement. `tariffId` reste la référence de
/// configuration (pour l'affichage du type/libellé), `amount` est le montant
/// réellement appliqué.
///
/// `onDelete: Restrict` sur les trois relations : aucune suppression physique
/// de Client/Property/Tariff n'est possible depuis l'app tant qu'une
/// réservation les référence (voir la mise à jour de deleteTariff()).
model Reservation {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  /// Jour calendaire de l'arrivée (affichage/filtrage "aujourd'hui/à venir").
  date DateTime

  /// Instants exacts (date + heure) — utilisés pour le calcul réel de
  /// disponibilité ; `departureTime` peut retomber le lendemain.
  arrivalTime   DateTime
  departureTime DateTime

  /// Copie figée depuis Tariff au moment de la création — jamais recalculée.
  durationValue Int
  durationUnit  DurationUnit
  amount        Int

  deposit       Int            @default(0)
  depositMethod PaymentMethod?

  status ReservationStatus @default(CONFIRMED)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Présent seulement si "Faire entrer" a été exécuté (Phase 7). Le lien
  /// est conservé indéfiniment : la réservation reste l'historique de
  /// l'origine de la location, elle n'est jamais supprimée.
  rental Rental?

  /// Paiements encaissés PENDANT que ce contexte était une réservation
  /// (avant toute arrivée). Voir le commentaire sur `model Payment` pour la
  /// règle anti double-comptage une fois qu'une Rental existe.
  payments Payment[]

  @@index([propertyId, status])
  @@index([clientId])
  @@index([arrivalTime])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 7 — Locations (Rental)
// ---------------------------------------------------------------------------

enum RentalStatus {
  /// Client actuellement dans le logement — bloque la disponibilité.
  ACTIVE
  /// Séjour terminé normalement — ne bloque plus, reste en historique.
  COMPLETED
  /// Annulée avant sa fin — ne bloque plus, reste en historique.
  CANCELLED
}

/// Un client réellement présent dans un logement — distinct d'une
/// Reservation (un créneau réservé pour le futur). Créée soit depuis une
/// réservation CONFIRMED ("Faire entrer"), soit directement ("Nouvelle
/// location", sans réservation).
///
/// `tariffId` est nullable (comme demandé) : les deux parcours actuels de
/// l'app renseignent toujours un tarif, mais le modèle n'exige pas qu'un
/// tarif existe pour toute location possible à l'avenir.
///
/// `onDelete: Restrict` partout : jamais de suppression physique de
/// Client/Property/Reservation/Tariff tant qu'une location les référence.
/// Une Rental elle-même n'est également jamais supprimée physiquement par
/// l'app — seul son statut change (voir RentalStatus).
model Rental {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  /// Une location directe n'a pas de réservation d'origine.
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  tariffId String?
  tariff   Tariff? @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  /// Heure RÉELLE d'arrivée — peut différer de l'heure prévue de la
  /// réservation d'origine, qui elle reste inchangée pour toujours (Bloc 9).
  arrivalAt DateTime

  /// Calculée à la création depuis arrivalAt + durée, puis déplacée par
  /// chaque prolongation (jamais par une simple édition).
  plannedDepartureAt DateTime
  actualDepartureAt  DateTime?

  /// Copie figée au moment de la création (depuis le Tariff choisi, ou
  /// depuis la Reservation d'origine si applicable) — jamais recalculée.
  durationValue Int
  durationUnit  DurationUnit

  /// Montant total COURANT = montant initial + somme des RentalExtension.
  /// Incrémenté à chaque prolongation, jamais écrasé (Bloc 15).
  amount Int

  /// Repris tel quel depuis la Reservation d'origine si applicable
  /// (Bloc 16) — jamais redemandé au gestionnaire dans ce cas.
  deposit Int @default(0)

  status RentalStatus @default(ACTIVE)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extensions RentalExtension[]

  /// Paiements encaissés PENDANT que ce contexte était une location (après
  /// l'arrivée). Pour une location née d'une réservation, le total réel payé
  /// additionne CES paiements-ci ET ceux de la réservation d'origine — voir
  /// src/lib/payment-summary.ts. `Rental.deposit` reste un champ historique
  /// figé (Bloc 2 de la Phase 8) : pour une location née d'un check-in, ce
  /// n'est qu'une COPIE de `Reservation.deposit`, jamais un paiement
  /// distinct — donc jamais reconverti en Payment séparément (voir
  /// prisma/backfill-payments.ts).
  payments Payment[]

  @@index([propertyId, status])
  @@index([clientId])
  @@index([status])
}

/// Journal append-only d'une prolongation (Bloc 15) : préserve le détail de
/// CHAQUE extension au lieu d'écraser un seul total, pour ne jamais perdre
/// l'historique si plusieurs prolongations sont accordées. Ce n'est pas un
/// système financier (pas de Payment/caisse/rapprochement) — seulement la
/// trace de comment Rental.amount a grandi dans le temps.
model RentalExtension {
  id       String @id @default(cuid())
  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  durationValue Int
  durationUnit  DurationUnit
  amount        Int

  createdAt DateTime @default(now())

  @@index([rentalId])
}

// ---------------------------------------------------------------------------
// Phase 8 — Paiements (Payment)
// ---------------------------------------------------------------------------

/// Un encaissement réel, saisi une fois, jamais modifié ni supprimé après
/// coup (Bloc 16) — la seule correction prévue pour V1 est une phase
/// financière ultérieure (contre-écriture), volontairement hors périmètre
/// ici.
///
/// EXACTEMENT UN des deux (reservationId, rentalId) doit être renseigné —
/// jamais les deux, jamais aucun. Contrainte appliquée à la fois côté
/// application (src/app/actions/payments.ts) ET côté base (contrainte CHECK
/// ajoutée à la migration `add_payments`) : Bloc 4 demandait "au minimum un
/// contexte valide", mais autoriser les deux à la fois romprait justement la
/// règle anti double-comptage que ce même bloc demande de préserver (un
/// paiement rattaché simultanément à une réservation ET à une location
/// apparaîtrait dans les deux résumés financiers) — durcir "au minimum" en
/// "exactement" est documenté ici plutôt que décidé silencieusement.
///
/// Pas de suppression physique de Reservation/Rental tant qu'un paiement les
/// référence (onDelete: Restrict), comme pour toutes les autres relations du
/// projet vers ces deux modèles.
///
/// Rattachement réservation → location (Bloc 19) : un paiement encaissé
/// AVANT l'arrivée reste lié à `reservationId` pour toujours (jamais
/// migré/déplacé vers `rentalId` au moment du check-in). Le total payé
/// d'une location née d'une réservation additionne donc les deux ensembles
/// (voir src/lib/payment-summary.ts), sans qu'aucune ligne ne soit jamais
/// comptée dans les deux totaux à la fois.
model Payment {
  id String @id @default(cuid())

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  rentalId String?
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  amount Int
  method PaymentMethod

  /// Toujours l'heure serveur au moment de l'encaissement (Bloc 11) — jamais
  /// une valeur envoyée par le navigateur. Aucune UI ne permet de saisir une
  /// date historique pour V1.
  paidAt DateTime @default(now())

  reference String?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([rentalId])
}
