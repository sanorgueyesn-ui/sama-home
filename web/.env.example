# Copier vers .env et renseigner de vraies valeurs (jamais commit .env).

# Connexion PostgreSQL de l'instance SAMA HOME (adapter votre host/port/rôle).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/samahome_dev?schema=public"

# Clé de signature des cookies de session — générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="generate-a-random-32-byte-base64-value"

# Premier compte gestionnaire, utilisé uniquement par `npx prisma db seed`
# (prisma/seed.ts) — jamais lu par l'application elle-même. À retirer de
# .env une fois le compte créé, si vous préférez.
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# Administrateur de PLATEFORME (distinct du compte ci-dessus — jamais un
# ADMIN d'établissement), utilisé uniquement par
# `scripts/bootstrap-platform-admin.mts` — jamais lu par l'application elle-
# même, jamais lancé automatiquement (voir ce script et
# docs/production/BOOTSTRAP_PLATFORM_ADMIN.md). BOOTSTRAP_PLATFORM_ADMIN_CONFIRM
# n'est requis qu'avec l'option --write de ce script (confirmation explicite,
# doit valoir exactement BOOTSTRAP_PLATFORM_ADMIN_USERNAME). À retirer de
# .env une fois le compte créé.
BOOTSTRAP_PLATFORM_ADMIN_USERNAME=""
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=""
BOOTSTRAP_PLATFORM_ADMIN_NAME=""
BOOTSTRAP_PLATFORM_ADMIN_CONFIRM=""
